# Copie para ".env" e preencha. Sem os VITE_SUPABASE_*, o site roda em
# "modo demonstração" (dados locais + localStorage), útil para desenvolver.

# ---- Banco / Auth (cliente) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E-mails da equipe (viram "equipe" no login). Separados por vírgula.
VITE_ADMIN_EMAILS=

# URL pública do site (canonical, OG, links dos e-mails). Sem barra no fim.
VITE_SITE_URL=https://eventos-regiao.vercel.app

# ---- SMTP (só na Vercel, nunca commitado) — ver docs/SMTP.md ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
