# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# Enquanto VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY estiverem vazias, o site
# funciona em "modo demonstração" com os dados locais de /public/dados/*.json.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E-mails que entram no sistema com papel de EQUIPE (moderação + métricas).
# Separe por vírgula. Os demais e-mails entram como ORGANIZADOR.
VITE_ADMIN_EMAILS=
